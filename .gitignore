# dotagents local state. `agents.lock` and `.agents/.gitignore` are listed literally
# because `dotagents doctor` checks for them; `.agents/.gitignore` (generated on install)
# covers the managed content inside .agents/.
agents.lock
.agents/.gitignore
/.agents/

# Tool-native folders generated by dotagents from .agents/ (never ignored by dotagents itself)
/.claude/skills
/.claude/agents/
/.codex/agents/
